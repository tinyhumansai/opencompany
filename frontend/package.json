{
  "name": "opencompany-console",
  "private": true,
  "version": "0.1.0",
  "description": "A company-agnostic operator console for any OpenCompany host, built with Vite + React.",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages-sdk": "tsc -p tsconfig.pages-sdk.json && vite build --config pages-sdk/vite.config.ts && vite build --config pages-sdk/vite.react.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "typecheck:unit": "tsc -p tsconfig.unit.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:live": "PW_LIVE_BRAIN=1 playwright test",
    "e2e:first-run": "PW_FIRST_RUN=1 playwright test",
    "e2e:live-llm": "PW_LIVE_LLM=1 playwright test",
    "e2e:euler": "PW_LIVE_LLM=1 PW_EULER=1 playwright test",
    "e2e:visual": "PW_VISUAL=1 playwright test",
    "e2e:visual:update": "PW_VISUAL=1 playwright test --update-snapshots",
    "tauri:dev": "../scripts/desktop-dev.sh",
    "tauri:build": "npm run build && cd ../src-tauri && ../frontend/node_modules/.bin/tauri build -- --features opencompany/acp,opencompany/composio"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.16",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2.10.1",
    "@types/d3-force": "^3.0.10",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^27.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
