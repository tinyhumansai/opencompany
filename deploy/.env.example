# Copy to .env and edit. Read by `docker compose`.

# ── The switch: which company (module) spins up ─────────────────────────────
# A company directory name under companies/, or a friendly alias.
#   dir names: marketing_agency, venture_capital,
#              software_company, venture_studio, law_firm,
#              signals_opportunity_studio, startup_accelerator, … (see companies/)
#   aliases:   marketing, fund, software, studio, law, accelerator, signals, …
# Leave blank explicitly to boot unconfigured into the first-run setup wizard.
OPENCOMPANY_COMPANY=marketing_agency

# ── Host + console ports ────────────────────────────────────────────────────
OPENCOMPANY_PORT=8080
CONSOLE_PORT=5173

# ── Optional build/runtime toggles ──────────────────────────────────────────
# Cargo features compiled into the host binary (blank = small default build).
#   e.g. "medulla tinyplace sqlite openhuman-rpc"
OPENCOMPANY_FEATURES=
# Go public on tiny.place at boot (needs the tinyplace feature to reach the net).
OPENCOMPANY_DISCOVERABLE=false

# ── Credentials (optional) ──────────────────────────────────────────────────
# Address admitted as the first email-auth administrator. Compose has no
# bundled login. After the first boot, initialize this address with:
#   ./scripts/init-demo-admin.sh marketing you@example.com
OPENCOMPANY_ADMIN_EMAIL=
# Unlocks live Medulla cognition; blank runs the offline demo brain.
TINYHUMANS_API_KEY=
# Only used by the feedback→issue flow.
GITHUB_TOKEN=
# Provider credential used by future live examples.
OPENAI_API_KEY=

# Storage backend: fs (default), sqlite, or mongodb. The mongodb backend is
# the multi-tenant platform option — the hosting layer injects a per-tenant
# database and scoped credentials (see docs/spec/runtime/storage.md).
OPENCOMPANY_STORAGE=fs
OPENCOMPANY_MONGODB_URI=
OPENCOMPANY_MONGODB_DB=

# Memory engine overlay: store (default — the base backend serves memory),
# remote (a hosted TinyMemory v2 engine), or null (discard — testing only).
# Full guide incl. the switch runbook: docs/spec/runtime/memory-engine.md.
# Instance-wide and read once at boot; switching engines is an infra-operator
# action: set, restart, verify /spec. `remote`/`null` need a build with the
# `tinymemory` cargo feature (on by default).
OPENCOMPANY_MEMORY=store
# Which engine (remote only): cortexdb (CortexDB direct API; `cortex` is
# accepted as an alias) | tinyhumans (CortexDB hosted by the TinyHumans backend).
# supermemory, mem0 and cognee are retired and refused at boot.
OPENCOMPANY_MEMORY_DRIVER=
# Optional engine endpoint override. Blank uses the engine's default
# (cortexdb: https://api-v1.cortexdb.ai, tinyhumans: https://api.tinyhumans.ai).
# A credentialed endpoint must be https, or http to a loopback host.
OPENCOMPANY_MEMORY_URL=
# Hosted engine credential (required for remote). Env is its only channel, on
# purpose — see docs/spec/runtime/memory-engine.md.
OPENCOMPANY_MEMORY_API_KEY=
# A no-op, kept so existing deployments that set it still boot (the in-pod
# engine it guarded was removed).
OPENCOMPANY_MEMORY_ALLOW_EPHEMERAL=

# ── Crash reporting (optional) ──────────────────────────────────────────────
# Errors and panics, sent to a Sentry project YOU own. Blank — the default —
# means nothing is sent and no client is constructed. Needs a build with the
# `crash-reporting` cargo feature; add it to OPENCOMPANY_FEATURES above.
# Full contract, including what is deliberately never sent:
# docs/spec/runtime/crash-reporting.md
OPENCOMPANY_SENTRY_DSN=
# `off` forbids reporting whatever else is set. For the case where the DSN is
# injected by something you do not edit.
OPENCOMPANY_SENTRY=
# The `environment` tag. Defaults to the deployment kind (self-hosted,
# hosted-tenant, desktop).
OPENCOMPANY_SENTRY_ENVIRONMENT=
# Performance tracing: the fraction of requests recorded as transactions, 0 to
# 1. Blank (= 0) is the default and records none. Transactions are billed
# SEPARATELY from errors and are emitted for every request, not only failures,
# so this is a recurring cost — start at 0.05 rather than 1.
OPENCOMPANY_SENTRY_TRACES_SAMPLE_RATE=
# The console's own DSN — a separate variable because it is a separate surface
# and usually a separate Sentry project. Read at BUILD time by Vite, so it has
# to be set when the console bundle is built, not when the host runs.
# Under Compose these reach the bundle as build args, so changing one needs
# `docker compose build console` rather than a restart. Blank here means `off`
# under Compose (an empty value would otherwise select the TinyHumans default
# DSN compiled into the console).
VITE_SENTRY_DSN=
# The console's `environment` tag. Defaults to development/production.
VITE_SENTRY_ENVIRONMENT=
# The console's traced fraction of page loads, 0 to 1. Blank (= 0) traces none.
VITE_SENTRY_TRACES_SAMPLE_RATE=
# Comma-separated origins the browser may attach `sentry-trace` headers to, so
# a console action and the host request it caused are ONE trace. Same-origin is
# always allowed, so leave this blank unless the console talks to a host on
# another origin.
VITE_SENTRY_TRACE_PROPAGATION_TARGETS=
# The commit the console bundle was built from, for the Sentry release tag and
# the source-map upload that keys off it. Blank means the tag carries the
# version only, and two builds become indistinguishable in Sentry. Compose
# cannot read git for you:
#   VITE_BUILD_COMMIT=$(git rev-parse HEAD) docker compose build console
VITE_BUILD_COMMIT=
